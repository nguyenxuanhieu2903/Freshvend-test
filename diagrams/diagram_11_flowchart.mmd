flowchart TD
    START(["Bắt đầu giao dịch"]) --> SELECT["Khách hàng duyệt & chọn khay trái cây trên màn hình"]
    SELECT --> CHECK_STOCK{"Kiểm tra số lượng tồn kho khả dụng?"}

    CHECK_STOCK -->|Không đủ| OUT_OF_STOCK["Thông báo hết hàng / yêu cầu giảm số lượng"]
    OUT_OF_STOCK --> SELECT

    CHECK_STOCK -->|Đủ tồn kho| CREATE_ORD["Tạo đơn hàng trạng thái PENDING_PAYMENT<br/>Tính tổng tiền phía máy chủ"]
    CREATE_ORD --> DISPLAY_PAY["Hiển thị mã QR thanh toán mô phỏng"]
    DISPLAY_PAY --> PAY_ACTION{"Khách hàng xác nhận thanh toán?"}

    PAY_ACTION -->|Thất bại / Hủy| CANCEL_PAY["Ghi nhận thanh toán FAILED<br/>Hủy đơn & xuất biên nhận thất bại"]
    CANCEL_PAY --> END_FAIL(["Kết thúc giao dịch thất bại"])

    PAY_ACTION -->|Thành công| SET_PAID["Cập nhật đơn hàng: PAID -> DISPENSING"]
    SET_PAID --> SEND_SERVO["Gửi tín hiệu kích hoạt động cơ Servo nhả khay"]
    SEND_SERVO --> VERIFY_DISP{"Cảm biến xác nhận khay đã rơi?"}

    VERIFY_DISP -->|Thành công| DISP_OK["Ghi nhận nhả hàng SUCCESS<br/>Trừ tồn kho (stockQuantity - Qty)<br/>Đơn hàng chuyển: COMPLETED"]
    DISP_OK --> RECEIPT["In / Hiển thị biên nhận điện tử hoàn tất<br/>Mở cửa sổ nhận sản phẩm"]
    RECEIPT --> CHECK_LOW{"Tồn kho <= Ngưỡng cảnh báo?"}

    CHECK_LOW -->|Có| GEN_ALERT["Tự động phát ALERT tồn kho thấp cho Operator"]
    CHECK_LOW -->|Không| END_SUCCESS(["Giao dịch hoàn tất thành công"])
    GEN_ALERT --> END_SUCCESS

    VERIFY_DISP -->|Kẹt hàng| RETRY_CHECK{"Đã thử lại đủ N = 2 lần chưa?"}
    RETRY_CHECK -->|Chưa đủ| RETRY_SERVO["Tự động đảo chiều Servo & nhả lại"]
    RETRY_SERVO --> VERIFY_DISP

    RETRY_CHECK -->|Đã hết lượt| DISP_FAIL["Chuyển đơn hàng sang: NEEDS_HANDLING<br/>Kích hoạt hoàn tiền mô phỏng (REFUND_PENDING)<br/>Tự động tạo sự cố INCIDENT cho Operator"]
    DISP_FAIL --> RECEIPT_ERR["Hiển thị biên nhận lỗi kèm mã sự cố hỗ trợ"]
    RECEIPT_ERR --> END_FAIL